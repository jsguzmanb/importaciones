DAATER_EMAIL=correo@empresa.com
DAATER_PASSWORD=tu_contraseña

# Connection string de Postgres (Supabase: Project Settings -> Database -> Connection
# string -> modo "Transaction" o "Session"). Usada tanto por el scraper (npm run search)
# como por el dashboard local (npm run dashboard) y en Vercel (variable de entorno).
DATABASE_URL=postgresql://usuario:password@host:5432/postgres
