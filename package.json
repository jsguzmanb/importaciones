{
  "name": "daater-automation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "search": "node --env-file=.env.local search-daater.mjs",
    "dashboard": "node --env-file=.env.local server.mjs",
    "vendor-chart": "node -e \"require('fs').copyFileSync('node_modules/chart.js/dist/chart.umd.min.js', 'public/vendor/chart.js')\"",
    "deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "playwright": "^1.47.0",
    "xlsx": "^0.18.5"
  }
}
